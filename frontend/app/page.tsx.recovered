                    </Button>
                  </Grid>
                  <Grid size={{ xs: 6, md: 2.5 }}>
                    <Button
                      fullWidth
                      startIcon={<TuneIcon />}
                      onClick={() => setShowDipSwitches(true)}
                      variant="contained"
                      disabled={!selectedModel}
                      sx={{
                        height: 56,
                        borderRadius: 3,
                        background: `linear-gradient(180deg, ${alpha(colors.accentCyan, 0.9)} 0%, ${alpha(colors.accentBlueDim, 0.95)} 100%)`,
                        border: `1px solid ${alpha(colors.accentCyan, 0.3)}`,
                        boxShadow: `
                          0 4px 12px ${alpha(colors.accentCyan, 0.2)},
                          inset 0 1px 0 ${alpha('#ffffff', 0.15)}
                        `,
                      }}
                    >
                      DipSW
                    </Button>
                  </Grid>
                </Grid>
              </Paper>

              {showDipSwitches && selectedModel && (
                <DipSwitchViewer
                  model={selectedModel}
                  target={dipSwitchTarget}
                  onClose={() => { setShowDipSwitches(false); setDipSwitchTarget(null); }}
                />
              )}

              {/* Error Results */}
              <Stack spacing={3}>
                {errorResults.map((err) => (
                  <ErrorCard key={err.id} error={err} onDipSwitchClick={onDipSwitchClick} model={selectedModel} />
                ))}
                {errorResults.length === 0 && !isPending && codeQuery && (
                  <Box
                    textAlign="center"
                    py={6}
                    sx={{
                      color: colors.textSecondary,
                      borderRadius: 3,
                      background: alpha(colors.bgSurface, 0.3),
                      border: `1px dashed ${colors.borderMid}`,
                    }}
                  >
                    <Typography variant="body1">No exact match found.</Typography>
                    <Typography variant="caption" sx={{ color: colors.textMuted }}>
                      Try a different error code or check the model selection.
                    </Typography>
                  </Box>
                )}
              </Stack>
            </Box>
          )}

          {/* ═══════════════════════════════════════ */}
          {/* SPARE PARTS SECTION                    */}
          {/* ═══════════════════════════════════════ */}
          {expandedSection === 'parts' && (
            <Box className="skeu-slide-in">
              {/* Back Button */}
              <Button
                variant="outlined"
                startIcon={<ArrowBackIcon />}
                onClick={() => {
                  setExpandedSection(null);
                  setSelectedModel('');
                  setErrorResults([]);
                  setPartResults([]);
                  setActiveTab(0);
                }}
                sx={{
                  mb: 3,
                  borderRadius: 3,
                  px: 3,
                  borderColor: colors.borderLight,
                  color: colors.textSecondary,
                  '&:hover': {
                    borderColor: colors.accentRed,
                    color: colors.accentRed,
                  },
                }}
              >
                Torna alla Home
              </Button>

              {/* Section Title */}
              <Box display="flex" alignItems="center" gap={2} mb={3}>
                <Box
                  sx={{
                    p: 1,
                    borderRadius: 2,
                    background: alpha(colors.accentRed, 0.1),
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                  }}
                >
                  <BuildIcon sx={{ color: colors.accentRed, fontSize: 28 }} />
                </Box>
                <Typography
                  variant="h5"
                  sx={{
                    fontWeight: 800,
                    color: colors.textPrimary,
                    letterSpacing: '-0.01em',
                  }}
                >
                  Spare Parts & Maintenance
                </Typography>
                <LEDIndicator color={colors.accentRed} />
              </Box>

              {/* Physical Tabs */}
              <Paper elevation={0} sx={{ borderRadius: 3, overflow: 'hidden', mb: 3, p: 0 }}>
                <Tabs
                  value={activeTab}
                  onChange={(e, v) => setActiveTab(v)}
                  variant="fullWidth"
                >
                  <Tab
                    icon={<SettingsIcon />}
                    label="Spare Parts"
                    iconPosition="start"
                  />
                  <Tab
                    icon={<PartIcon />}
                    label="Maintenance"
                    iconPosition="start"
                  />
                </Tabs>
              </Paper>

              {/* === CONTENT: SPARE PARTS === */}
              {activeTab === 0 && (
                <Box className="skeu-fade-in">
                  <Paper elevation={0} sx={{ p: 4, borderRadius: 3, mb: 4, position: 'relative' }}>
                    <Screw position="tl" />
                    <Screw position="tr" />

                    {/* Sub-mode toggle */}
                    <Box display="flex" gap={2} mb={3} borderBottom={1} borderColor="divider" pb={2} flexWrap="wrap">
                      <Button
                        onClick={() => setPartSearchMode('smart')}
                        variant={partSearchMode === 'smart' ? 'contained' : 'outlined'}
                        sx={{
                          borderRadius: 20,
                          ...(partSearchMode === 'smart' && {
                            background: `linear-gradient(180deg, ${alpha(colors.accentCyan, 0.9)} 0%, ${alpha(colors.accentBlueDim, 0.95)} 100%)`,
                          }),
                        }}
                      >
                        Smart Search
                      </Button>
                      <Button
                        onClick={() => setPartSearchMode('section')}
                        variant={partSearchMode === 'section' ? 'contained' : 'outlined'}
                        sx={{
                          borderRadius: 20,
                          ...(partSearchMode === 'section' && {
                            background: `linear-gradient(180deg, ${alpha(colors.accentCyan, 0.9)} 0%, ${alpha(colors.accentBlueDim, 0.95)} 100%)`,
                          }),
                        }}
                      >
                        Browse Sections
                      </Button>

                      <Box flexGrow={1} />
                      <Button
                        variant="outlined"
                        startIcon={<FavoriteIcon />}
                        onClick={() => setIsCartOpen(true)}
                        sx={{
                          borderColor: alpha(colors.accentRed, 0.5),
                          color: colors.accentRed,
                          '&:hover': {
                            borderColor: colors.accentRed,
                            background: alpha(colors.accentRed, 0.08),
                            boxShadow: `0 0 12px ${alpha(colors.accentRed, 0.2)}`,
                          },
                        }}
                      >
                        Favorites ({cart.length})
                      </Button>
                    </Box>

                    {partSearchMode === 'smart' ? (
                      <Grid container spacing={2}>
                        <Grid size={{ xs: 12 }}>
                          <PartSearchAutocomplete
                            model=""
                            onSelect={(part) => {
                              if (part) setPartResults([part]);
                            }}
                            onResults={(results) => {
                              setPartResults(results);
                            }}
                            placeholder="Search Part Code (Global Search)..."
                          />
                        </Grid>
                      </Grid>
                    ) : (
                      <Grid container spacing={2} alignItems="center">
                        <Grid size={{ xs: 12, md: 6 }}>
                          <TextField
                            select
                            fullWidth
                            label="Seleziona Modello"
                            value={selectedModel}
                            onChange={(e) => {
                              setSelectedModel(e.target.value);
                              setPartSection('');
                              setPartResults([]);
                            }}
                            variant="outlined"
                          >
                            <MenuItem value=""><em>Seleziona un modello</em></MenuItem>
                            {printers.map((p) => (
                              <MenuItem key={p.id} value={p.model_name}>
                                {p.model_name}
                              </MenuItem>
                            ))}
                          </TextField>
                        </Grid>
                        <Grid size={{ xs: 12, md: 6 }}>
                          <TextField
                            select
                            fullWidth
                            label="Seleziona Sezione"
                            value={partSection}
                            onChange={(e) => setPartSection(e.target.value)}
                            disabled={!selectedModel}
                            variant="outlined"
                          >
                            <MenuItem value=""><em>Seleziona Sezione</em></MenuItem>
                            {partSectionsList.map(s => <MenuItem key={s} value={s}>{s}</MenuItem>)}
                          </TextField>
                        </Grid>
                      </Grid>
                    )}
                  </Paper>

                  {/* Parts Results Table */}
                  {partResults.length > 0 && (
                    <Paper elevation={0} sx={{ borderRadius: 3, overflow: 'hidden' }}>
                      <Box
                        p={2}
                        sx={{
                          background: `linear-gradient(180deg, ${colors.bgSurface} 0%, ${alpha(colors.bgPanel, 0.95)} 100%)`,
                          borderBottom: `2px solid ${colors.borderLight}`,
                          display: 'flex',
                          alignItems: 'center',
                          gap: 1,
                        }}
                      >
                        <LEDIndicator color={colors.accentGreen} size={6} />
                        <Typography variant="h6" fontWeight={700}>Results ({partResults.length})</Typography>
                      </Box>
                      <TableContainer sx={{ maxHeight: 600 }}>
                        <Table stickyHeader>
                          <TableHead>
                            <TableRow>
                              <TableCell width={70}>Pg</TableCell>
                              <TableCell width={60}>Key</TableCell>
                              <TableCell>Model</TableCell>
                              <TableCell>Code</TableCell>
                              <TableCell>Name</TableCell>
                              <TableCell width={60}>Qty</TableCell>
                              <TableCell>Section</TableCell>
                              <TableCell width={80}>Fav</TableCell>
                            </TableRow>
                          </TableHead>
                          <TableBody>
                            {partResults.map((part, idx) => {
                              const uniqueId = `${part.model}-${part.page_number}-${part.part_code}-${part.section_name}-${part.ref_number}`;
                              const isFav = cart.some(i => `${i.model}-${i.page_number}-${i.part_code}-${i.section_name}-${i.ref_number}` === uniqueId);

                              return (
                                <TableRow key={uniqueId || idx} hover>
                                  <TableCell>{part.page_number}</TableCell>
                                  <TableCell>{part.ref_number}</TableCell>
                                  <TableCell><Chip label={part.model} size="small" color="primary" variant="outlined" /></TableCell>
                                  <TableCell sx={{ fontFamily: 'monospace', color: colors.accentBlue, fontWeight: 'bold' }}>
                                    {part.part_code}
                                  </TableCell>
                                  <TableCell>{part.name}</TableCell>
                                  <TableCell>{part.quantity}</TableCell>
                                  <TableCell><Chip label={part.section_name} size="small" /></TableCell>
                                  <TableCell>
                                    <IconButton
                                      onClick={() => {
                                        if (isFav) {
                                          const itemToRemove = cart.find(c => `${c.model}-${c.page_number}-${c.part_code}-${c.section_name}-${c.ref_number}` === uniqueId);
                                          if (itemToRemove) removeFromCart(itemToRemove.cartId);
                                          toast.success('Removed from favorites');
                                        } else {
                                          addToCart(part);
                                        }
                                      }}
                                      sx={{
                                        color: isFav ? colors.accentRed : colors.textSecondary,
                                        '&:hover': {
                                          color: colors.accentRed,
                                          boxShadow: `0 0 12px ${alpha(colors.accentRed, 0.3)}`,
                                        },
                                      }}
                                    >
                                      {isFav ? <FavoriteIcon /> : <FavoriteBorderIcon />}
                                    </IconButton>
                                  </TableCell>
                                </TableRow>
                              )
                            })}
                          </TableBody>
                        </Table>
                      </TableContainer>
                    </Paper>
                  )}
                </Box>
              )}

              {/* === CONTENT: MAINTENANCE === */}
              {activeTab === 1 && (
                <Box className="skeu-fade-in">
                  <Paper elevation={0} sx={{ p: 3, borderRadius: 3, mb: 3, position: 'relative' }}>
                    <Screw position="tl" />
                    <Screw position="tr" />

                    <Typography variant="h5" gutterBottom sx={{ fontWeight: 'bold', color: colors.accentBlue }}>
                      Maintenance Schedule
                    </Typography>

                    {/* Model Selector */}
                    <Box sx={{ mb: 3 }}>
                      <TextField
                        select
                        fullWidth
                        label="Select Model"
                        value={selectedMaintenanceModel}
                        onChange={(e) => setSelectedMaintenanceModel(e.target.value)}
                        variant="outlined"
                        sx={{ maxWidth: '400px' }}
                      >
                        {Object.keys(maintenanceData).sort().map((model) => (
                          <MenuItem key={model} value={model}>
                            {model}
                          </MenuItem>
                        ))}
                      </TextField>
                    </Box>

                    {maintenanceData[selectedMaintenanceModel]?.map((section, idx) => (
                      <Accordion key={idx}>
                        <AccordionSummary expandIcon={<ExpandMoreIcon />}>
                          <Box display="flex" alignItems="center" gap={1}>
                            <LEDIndicator color={colors.accentAmber} size={6} />
                            <Typography fontWeight="bold">{section.name}</Typography>
                          </Box>
                        </AccordionSummary>
                        <AccordionDetails>
                          <TableContainer>
                            <Table size="small">
                              <TableHead>
                                <TableRow>
                                  <TableCell>Code</TableCell>
                                  <TableCell>Name</TableCell>
                                  <TableCell>Qty</TableCell>
                                  <TableCell>Life (Yield)</TableCell>
                                  <TableCell width={80}>Fav</TableCell>
                                </TableRow>
                              </TableHead>
                              <TableBody>
                                {section.items.map((item: any, i: number) => {
                                  const maintenancePart: Part = {
                                    part_code: item.code,
                                    name: item.name,
                                    section_name: section.name,
                                    model: selectedMaintenanceModel,
                                    quantity: item.qty,
                                    page_number: item.page_key?.split('-')[0] || '',
                                    ref_number: `${section.name}-${i}`,
                                  };

                                  const uniqueId = `${maintenancePart.model}-${maintenancePart.ref_number}-${maintenancePart.part_code}`;
                                  const isFav = cart.some(c => `${c.model}-${c.ref_number}-${c.part_code}` === uniqueId);

                                  return (
                                    <TableRow key={i} hover>
                                      <TableCell sx={{ fontFamily: 'monospace', color: colors.accentBlue, fontWeight: 'bold' }}>
                                        {item.code}
                                      </TableCell>
                                      <TableCell>{item.name}</TableCell>
                                      <TableCell>{item.qty}</TableCell>
                                      <TableCell>{item.life}</TableCell>
                                      <TableCell>
                                        <IconButton
                                          onClick={() => {
                                            if (isFav) {
                                              const itemToRemove = cart.find(c => `${c.model}-${c.ref_number}-${c.part_code}` === uniqueId);
                                              if (itemToRemove) removeFromCart(itemToRemove.cartId);
                                              toast.success('Removed from favorites');
                                            } else {
                                              addToCart(maintenancePart);
                                            }
                                          }}
                                          sx={{
                                            color: isFav ? colors.accentRed : colors.textSecondary,
                                            '&:hover': {
                                              color: colors.accentRed,
                                              boxShadow: `0 0 12px ${alpha(colors.accentRed, 0.3)}`,
                                            },
                                          }}
                                        >
                                          {isFav ? <FavoriteIcon /> : <FavoriteBorderIcon />}
                                        </IconButton>
                                      </TableCell>
                                    </TableRow>
                                  )
                                })}
                              </TableBody>
                            </Table>
                          </TableContainer>
                        </AccordionDetails>
                      </Accordion>
                    ))}
                  </Paper>
                </Box>
              )}
            </Box>
          )}



        </Stack>
      </Container>


      {/* ═══════════════════════════════════════ */}
      {/* FAVORITES DRAWER                       */}
      {/* ═══════════════════════════════════════ */}
      <Drawer
        anchor="right"
        open={isCartOpen}
        onClose={() => setIsCartOpen(false)}
        PaperProps={{
          sx: {
            width: { xs: '100%', sm: 380 },
          }
        }}
      >
        {/* Drawer Header */}
        <Box
          p={2}
          display="flex"
          justifyContent="space-between"
          alignItems="center"
          sx={{
            borderBottom: `2px solid ${colors.borderLight}`,
            background: `linear-gradient(180deg, ${colors.bgSurface} 0%, ${colors.bgPanel} 100%)`,
          }}
        >
          <Typography variant="h6" display="flex" alignItems="center" gap={1} fontWeight={700}>
            <FavoriteIcon sx={{ color: colors.accentRed }} /> Favorites List
          </Typography>
          <Chip
            label={cart.length}
            size="small"
            sx={{
              background: alpha(colors.accentRed, 0.2),
              color: colors.accentRed,
              fontWeight: 700,
              border: `1px solid ${alpha(colors.accentRed, 0.3)}`,
            }}
          />
        </Box>

        {/* Drawer Items */}
        <List sx={{ flex: 1, overflow: 'auto' }}>
          {cart.length === 0 && (
            <Box p={4} textAlign="center" sx={{ color: colors.textSecondary }}>
              <FavoriteBorderIcon sx={{ fontSize: 48, color: colors.textMuted, mb: 1 }} />
              <Typography variant="body2">No favorites yet.</Typography>
              <Typography variant="caption" sx={{ color: colors.textMuted }}>
                Add parts from search results.
              </Typography>
            </Box>
          )}
          {cart.map(item => (
            <div key={item.cartId}>
              <ListItem
                secondaryAction={
                  <IconButton
                    edge="end"
                    onClick={() => removeFromCart(item.cartId)}
                    sx={{
                      color: colors.textMuted,
                      '&:hover': { color: colors.accentRed },
                    }}
                  >
                    <DeleteIcon />
                  </IconButton>
                }
              >
                <ListItemText
                  primary={
                    <Box display="flex" alignItems="center" gap={1}>
                      <Typography fontFamily="monospace" fontWeight="bold" sx={{ color: colors.accentBlue }}>
                        {item.part_code}
                      </Typography>
                      <Box display="flex" alignItems="center" gap={0.5} ml={1}>
                        <IconButton
                          size="small"
                          onClick={() => {
                            const updated = cart.map(c =>
                              c.cartId === item.cartId
                                ? { ...c, quantity: String(Math.max(1, parseInt(c.quantity || '1') - 1)) }
                                : c
                            );
                            setCart(updated);
                          }}
                          sx={{ color: colors.textSecondary }}
                        >
                          -
                        </IconButton>
                        <Chip
                          label={item.quantity || '1'}
                          size="small"
                          sx={{
                            fontWeight: 700,
                            minWidth: 32,
                          }}
                        />
                        <IconButton
                          size="small"
                          onClick={() => {
                            const updated = cart.map(c =>
                              c.cartId === item.cartId
                                ? { ...c, quantity: String(parseInt(c.quantity || '1') + 1) }
                                : c
                            );
                            setCart(updated);
                          }}
                          sx={{ color: colors.textSecondary }}
                        >
                          +
                        </IconButton>
                      </Box>
                    </Box>
                  }
                  secondary={
                    <Typography variant="caption" sx={{ color: colors.textMuted }}>
                      {item.name} | {item.model} - {item.section_name}
                    </Typography>
                  }
                />
              </ListItem>
              <Divider />
            </div>
          ))}
        </List>

        {/* Drawer Footer */}
        <Box
          p={2}
          display="flex"
          flexDirection="column"
          gap={1}
          sx={{
            borderTop: `2px solid ${colors.borderLight}`,
            background: `linear-gradient(180deg, ${colors.bgPanel} 0%, ${colors.bgSurface} 100%)`,
          }}
        >
          <Button
            variant="outlined"
            fullWidth
            onClick={() => { setCart([]); toast.success('Favorites cleared'); }}
            sx={{
              borderColor: alpha(colors.accentRed, 0.3),
              color: colors.accentRed,
              '&:hover': {
                borderColor: colors.accentRed,
                background: alpha(colors.accentRed, 0.08),
              },
            }}
          >
            Empty Favorites
          </Button>
          <Box display="flex" gap={1}>
            <Button
              variant="outlined"
              startIcon={<CopyIcon />}
              onClick={copyCart}
              disabled={cart.length === 0}
              fullWidth
            >
              Copy
            </Button>
            <Button
              variant="contained"
              startIcon={<PrintIcon />}
              onClick={printCart}
              disabled={cart.length === 0}
              fullWidth
            >
              Print
            </Button>
          </Box>
        </Box>
      </Drawer>

    </Box>
  );
}�
